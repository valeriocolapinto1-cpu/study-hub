{
  "name": "study-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Siti di studio per Ingegneria Elettronica: teoria, esercizi, ripasso e simulazioni d'esame (IT/EN).",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:fixtures": "PUBLIC_STUDY_HUB_FIXTURES=1 astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:content": "vitest run tests/content",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "lhci": "lhci autorun --config=lighthouserc.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:links": "node tools/check-links.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/mdx": "8.1.2",
    "@astrojs/preact": "6.1.1",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "astro": "7.4.5",
    "jsqr": "1.4.0",
    "katex": "0.19.1",
    "preact": "11.1.1",
    "qrcode-generator": "2.0.4",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.63.0",
    "@testing-library/preact": "3.2.6",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@axe-core/playwright": {
      "playwright-core": "1.63.0"
    }
  }
}
