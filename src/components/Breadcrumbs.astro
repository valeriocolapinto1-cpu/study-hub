---
import JsonLd from './JsonLd.astro';
import { t, type Lang } from '../i18n';
import { breadcrumbJsonLd } from '../lib/seo';
export interface Crumb {
  label: string;
  href?: string | undefined;
}
interface Props {
  lang: Lang;
  items: Crumb[];
}
const { lang, items } = Astro.props;
// Su telefono resta visibile solo il livello superiore («← Teoria»): il resto è nell'intestazione.
const parent = items.findLastIndex((c, i) => i < items.length - 1 && c.href);
// Dati strutturati: URL assoluti; la pagina corrente è l'URL della pagina.
const site = Astro.site ?? new URL('http://localhost');
const structured = breadcrumbJsonLd(
  items.map((c, i) => ({
    label: c.label,
    url:
      i === items.length - 1
        ? new URL(Astro.url.pathname, site).href
        : c.href
          ? new URL(c.href, site).href
          : undefined,
  })),
);
---

<nav class="breadcrumbs" aria-label={t(lang, 'breadcrumbs.label')}>
  <ol>
    {items.map((c, i) =>
      i === items.length - 1 || !c.href ? (
        <li>
          <span aria-current={i === items.length - 1 ? 'page' : undefined}>{c.label}</span>
        </li>
      ) : (
        <li data-parent={i === parent ? '' : undefined}>
          <a href={c.href}>{c.label}</a>
        </li>
      ),
    )}
  </ol>
</nav>
<JsonLd data={structured} />
