---
/** Voce del formulario: formula, simboli, uso, errore tipico, rimando alla teoria e segnalibro. */
import Formula from '../Formula.astro';
import InlineTex from '../InlineTex.astro';
import { texToPlain } from '../../lib/inline-tex';
import { t, tr, type Lang } from '../../i18n';
import type { Formula as FormulaData } from '../../content/schemas';

interface Props {
  lang: Lang;
  formula: FormulaData;
  theoryHref?: string | undefined;
  topicTitle?: string | undefined;
  /** Mostra il pulsante segnalibro (non in stampa). */
  bookmark?: boolean;
  compact?: boolean;
  /** KaTeX già reso dalla pagina (vedi lib/katex-sprite). */
  html?: string | undefined;
}
const { lang, formula: f, theoryHref, topicTitle, bookmark = true, compact = false, html } = Astro.props;
const labelTex = tr(f.label, lang);
const label = texToPlain(labelTex);
const search = [
  label,
  f.symbols && texToPlain(tr(f.symbols, lang)),
  f.usage && texToPlain(tr(f.usage, lang)),
  topicTitle,
  f.id,
]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();
---

<article
  class="formula-entry"
  data-formula={f.id}
  data-note-id={`formula-${f.id}`}
  data-search={search}
  id={`voce-${f.id}`}
>
  <div class="formula-entry__head">
    <h3 class="formula-entry__title">
      <InlineTex text={labelTex} />
    </h3>
    <span class="formula-entry__actions">
      {bookmark && (
        <button
          type="button"
          class="icon-btn icon-btn--bare formula-entry__star no-print"
          data-bookmark={f.id}
          aria-pressed="false"
          aria-label={t(lang, 'formulary.bookmark', { name: label })}
        >
          {/* Stella dallo sprite della pagina (simbolo #i-star, vedi lib/katex-sprite). */}
          <svg width="20" height="20" aria-hidden="true" focusable="false">
            <use href="#i-star" />
          </svg>
        </button>
      )}
      {/* Slot del pulsante appunti: spazio riservato, nessuno spostamento all'idratazione. */}
      <span class="sh-note-slot no-print" data-note-slot></span>
    </span>
  </div>
  <Formula id={f.id} tex={lang === 'en' && f.latexEn ? f.latexEn : f.latex} html={html} />
  {!compact && (
    <dl class="formula-entry__meta">
      {f.symbols && (
        <>
          <dt>{t(lang, 'formulary.symbols')}</dt>
          <dd>
            <InlineTex text={tr(f.symbols, lang)} />
          </dd>
        </>
      )}
      {f.usage && (
        <>
          <dt>{t(lang, 'formulary.usage')}</dt>
          <dd>
            <InlineTex text={tr(f.usage, lang)} />
          </dd>
        </>
      )}
      {f.pitfall && (
        <>
          <dt>{t(lang, 'formulary.pitfall')}</dt>
          <dd>
            <InlineTex text={tr(f.pitfall, lang)} />
          </dd>
        </>
      )}
      {f.note && (
        <>
          <dt>{t(lang, 'callout.nota')}</dt>
          <dd>
            <InlineTex text={tr(f.note, lang)} />
          </dd>
        </>
      )}
    </dl>
  )}
  {theoryHref && topicTitle && !compact && (
    <p class="formula-entry__link">
      <a href={theoryHref}>{t(lang, 'formulary.theory', { topic: topicTitle })}</a>
    </p>
  )}
</article>
