---
/**
 * Sezione Ripasso di un corso: coda FSRS delle flashcard (definizioni, formule, domande d'orale).
 * Uso: <CourseReview lang={lang} courseId="fisica-1" />
 */
import 'katex/dist/katex.min.css';
import ReviewSession from '../../islands/ReviewSession';
import KeysPanel from './KeysPanel.astro';
import SectionHeader from './SectionHeader.astro';
import { getCourseIndex } from '../../lib/course-data';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
  courseId: string;
}
const { lang, courseId } = Astro.props;
// Solo le voci delle carte: fronte e retro arrivano da dati/<argomento>.json quando servono.
const data = await getCourseIndex(courseId, lang);
const decks = [
  { courseId, title: data.title, dataPath: data.paths.data, cards: data.cards, examDates: data.examDates },
];
---

<SectionHeader title={t(lang, 'page.review.title')} lead={t(lang, 'page.review.lead')} />
<ReviewSession client:load lang={lang} decks={decks} />
<KeysPanel
  lang={lang}
  id="sh-review-keys"
  items={[
    [t(lang, 'keys.review.space'), t(lang, 'keys.review.flip')],
    ['1 – 4', t(lang, 'keys.review.rate')],
  ]}
/>
