---
/**
 * Esercizi di un argomento: un ExercisePlayer per esercizio (idratato quando visibile) + appunti.
 * Uso: <TopicExercises lang={lang} courseId="fisica-2" topicId="legge-di-gauss" />
 */
import 'katex/dist/katex.min.css';
import ExercisePlayer from '../../islands/ExercisePlayer';
import SectionHeader from './SectionHeader.astro';
import Notes from './Notes.astro';
import { getCourseData, leanExercise, pregeneratedDefault } from '../../lib/course-data';
import { compactMathDeep } from '../../lib/rich-server';
import { dataUrl } from '../../engine/course-data';
import { hashString } from '../../engine/random';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
  courseId: string;
  topicId: string;
}
const { lang, courseId, topicId } = Astro.props;
const data = await getCourseData(courseId, lang);
const topic = data.topics.find((tp) => tp.id === topicId);
if (!topic) throw new Error(`${courseId}: argomento sconosciuto "${topicId}"`);
// la prima variante dei generati è resa qui: nel browser si scarica solo per «nuova variante».
// Le props sono leggere: soluzioni e spiegazioni si scaricano da dati/<argomento>.json quando servono.
const full = await Promise.all(
  data.exercises.filter((e) => e.topic === topicId).map((e) => pregeneratedDefault(e, lang)),
);
// enunciato e figura vanno negli slot (una sola volta nell'HTML), non nelle props
const exercises = full.map(({ statementHtml, figureSvg, ...e }) => ({
  exercise: compactMathDeep(leanExercise(e as never)),
  statementHtml,
  figureSvg,
}));
const topicData = dataUrl(data.paths.data, topicId);
---

<SectionHeader title={t(lang, 'page.topicExercises', { topic: topic.title })}>
  <p>
    <a href={data.paths.exercises}>← {t(lang, 'page.backToList')}</a>
  </p>
</SectionHeader>
<div class="sh-exercise-stack">
  {exercises.map(({ exercise, statementHtml, figureSvg }, i) => (
    <ExercisePlayer
      client:visible
      lang={lang}
      courseId={courseId}
      exercise={exercise}
      dataUrl={topicData}
      number={i + 1}
      headingLevel={2}
      seed={hashString(exercise.id)}
    >
      <Fragment slot="statement" set:html={statementHtml ?? ''} />
      {figureSvg && <Fragment slot="figure" set:html={figureSvg} />}
    </ExercisePlayer>
  ))}
</div>
<Notes lang={lang} scope={courseId} />
