---
/**
 * Sezione Esercizi di un corso: elenco filtrabile con link alle pagine per argomento.
 * Uso (pagina generica già presente): <CourseExercises lang={lang} courseId="fisica-2" />
 */
import ExerciseList, { packItem } from '../../islands/ExerciseList';
import SectionHeader from './SectionHeader.astro';
import { getCourseData } from '../../lib/course-data';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
  courseId: string;
}
const { lang, courseId } = Astro.props;
const data = await getCourseData(courseId, lang);
// Le opzioni di un <select> non possono contenere KaTeX: obiettivi in testo semplice (senza `tex`).
const topics = data.topics.map((tp) => ({
  ...tp,
  objectives: tp.objectives.map(({ id, text }) => ({ id, text })),
}));
const counts = new Map<string, number>();
for (const e of data.exercises) counts.set(e.topic, (counts.get(e.topic) ?? 0) + 1);
const items = data.exercises
  .map((e) => ({
    id: e.id,
    topic: e.topic,
    objectives: e.objectives,
    difficulty: e.difficulty,
    title:
      e.kind === 'generated' && !e.statementHtml
        ? `${data.topics.find((tp) => tp.id === e.topic)?.title ?? e.topic} · ${t(lang, 'engine.generated')}`
        : e.title,
    generated: e.kind === 'generated',
  }))
  .map(packItem);
---

<SectionHeader title={t(lang, 'page.exercises.title')} lead={t(lang, 'page.exercises.lead')} />
<nav class="page-toc page-toc--inline" aria-label={t(lang, 'engine.topic')}>
  <ul class="sh-topic-links">
    {topics.map((tp) => {
      const n = counts.get(tp.id) ?? 0;
      return n > 0 ? (
        <li>
          <a href={`#t-${tp.id}`}>{tp.title}</a> <span class="sh-muted">({n})</span>
        </li>
      ) : null;
    })}
  </ul>
</nav>
<ExerciseList
  client:load
  lang={lang}
  courseId={courseId}
  exercisesPath={data.paths.exercises}
  topics={topics}
  items={items}
/>
