---
/** Marchio dei siti originali: una V in un riquadro arrotondato, con gradiente ciano → indaco → viola. */
interface Props {
  class?: string;
  title?: string;
  /** Id del gradiente: unico per pagina quando il marchio compare più volte (es. intestazione e piè di pagina). */
  gradientId?: string;
}
const { class: cls = 'brand__mark', title, gradientId = 'brand-grad' } = Astro.props;
---

<svg
  class={cls}
  viewBox="0 0 64 64"
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
  aria-label={title}
  focusable="false"
>
  <defs>
    <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#3ce6ff"></stop>
      <stop offset=".55" stop-color="#8b93ff"></stop>
      <stop offset="1" stop-color="#c483ff"></stop>
    </linearGradient>
  </defs>
  <rect
    x="2"
    y="2"
    width="60"
    height="60"
    rx="16"
    fill="rgba(140,160,255,.06)"
    stroke={`url(#${gradientId})`}
    stroke-opacity=".75"
    stroke-width="2.5"
  ></rect>
  <path
    d="M17 20l15 26 15-26"
    fill="none"
    stroke={`url(#${gradientId})`}
    stroke-width="5"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
</svg>
