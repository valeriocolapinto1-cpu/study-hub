---
/**
 * Interruttore unico chiaro/scuro. La logica è in src/scripts/site.ts
 * (delegazione sul click di [data-theme-toggle]); lo stato iniziale lo applica
 * lo script inline di Head.astro prima del primo disegno.
 */
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<button
  type="button"
  class="icon-btn theme-toggle"
  data-theme-toggle
  aria-pressed="false"
  aria-label={t(lang, 'theme.toggle')}
  data-label-light={t(lang, 'theme.toLight')}
  data-label-dark={t(lang, 'theme.toDark')}
>
  <Icon name="moon" class="icon-moon" />
  <Icon name="sun" class="icon-sun" />
</button>
