---
import '../styles/base.css';
import '../styles/components.css';
import '../styles/prose.css';
import '../styles/originale.css';
import '../styles/print.css';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { BASE_URL } from '../config/site';
import { htmlLang, stripLang, t, texts, tr, type Lang } from '../i18n';
import { sortCourses } from '../lib/courses';
import { pageSearchType, pagefindFilter } from '../lib/search/records';

// Tinte d'accento dei corsi: ogni file ridefinisce solo --accent* sotto html[data-course].
import.meta.glob('../styles/courses/*.css', { eager: true });

export interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Id del corso: imposta data-course (tinta d'accento). */
  course?: string | undefined;
  alternates?: boolean;
  noindex?: boolean;
  /** Classe di <body> (es. varianti di stampa). */
  bodyClass?: string | undefined;
}
const { lang, title, description, course, alternates = true, noindex = false, bodyClass } = Astro.props;
// Ricerca: solo le pagine indicizzabili espongono il contenuto a Pagefind, con tipo e corso.
const courseEntries = (await getCollection('courses')).map((c) => c.data);
const courseData = course ? courseEntries.find((c) => c.id === course) : undefined;
const searchType = noindex ? null : pageSearchType(stripLang(Astro.url.pathname), course);
const searchConfig = {
  lang,
  base: BASE_URL,
  courses: sortCourses(courseEntries).map((c) => ({
    id: c.id,
    title: tr(c.title, lang),
  })),
  texts: { ...texts(lang, 'search.'), label: t(lang, 'search.label') },
};
---

<!doctype html>
<html lang={htmlLang[lang]} data-course={course} data-area={course ? 'course' : 'hub'}>
  <head>
    <Head lang={lang} title={title} description={description} alternates={alternates} noindex={noindex} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    {!course && (
      <div class="bg-orbs" aria-hidden="true">
        <span class="orb orb--1" />
        <span class="orb orb--2" />
        <span class="orb orb--3" />
        <span class="bg-orbs__grid" />
      </div>
    )}
    <Header lang={lang} samePage={alternates} course={courseData} />
    <slot name="before-main" />
    <main
      id="contenuto"
      tabindex="-1"
      data-pagefind-body={searchType ? '' : undefined}
      data-pagefind-filter={searchType ? pagefindFilter('tipo', searchType) : undefined}
    >
      {searchType && course && <span hidden data-pagefind-filter={pagefindFilter('corso', course)} />}
      <slot />
    </main>
    <Footer lang={lang} />
    <script type="application/json" id="sh-search-config" set:html={JSON.stringify(searchConfig)} />
    <template
      id="sh-pwa-texts"
      data-title={t(lang, 'pwa.title')}
      data-body={t(lang, 'pwa.body')}
      data-reload={t(lang, 'pwa.reload')}
      data-later={t(lang, 'pwa.later')}
    ></template>
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
