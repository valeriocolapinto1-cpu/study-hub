---
/**
 * Layout delle pagine di un corso: accento del corso, indice del corso (sezioni + sommario
 * argomenti) presente UNA volta nel DOM — barra laterale da 1024 px, menu (popover) sotto —,
 * una riga sola con pulsante dell'indice, percorso e occhiello, colonna di lettura e strumenti
 * di pagina (Segnala errore); sotto i 48em la barra in basso con le sezioni di studio.
 */
import 'katex/dist/katex.min.css';
import '../styles/telefono.css';
import type { CollectionEntry } from 'astro:content';
import type { Topic } from '../content/schemas';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs, { type Crumb } from '../components/Breadcrumbs.astro';
import CourseNav from '../components/CourseNav.astro';
import CourseTabBar from '../components/CourseTabBar.astro';
import Icon from '../components/Icon.astro';
import ReportError from '../components/ReportError.astro';
import TopicNav from '../components/TopicNav.astro';
import OfflineCourse from '../islands/OfflineCourse';
import { localizePath, stripLang, t, texts, tr, withBase, type Lang } from '../i18n';
import { COURSE_SECTIONS, coursePath } from '../lib/courses';

interface Props {
  lang: Lang;
  course: CollectionEntry<'courses'>['data'];
  /** Titolo della pagina (senza il nome del corso). */
  title?: string;
  description?: string;
  /** Argomenti del corso per il sommario laterale (teoria, esercizi). */
  topics?: Pick<Topic, 'id' | 'order' | 'title' | 'group'>[] | undefined;
  topicSection?: 'teoria' | 'esercizi';
  currentTopic?: string | undefined;
  /** Percorso personalizzato; se assente si ricava dall'URL. */
  crumbs?: Crumb[] | undefined;
  /** Colonna larga (tabelle, simulatori) invece della misura di lettura. */
  wide?: boolean;
  /** Occhiello della pagina (capitolo, anno): sta nella stessa riga del percorso. */
  eyebrow?: string | undefined;
}
const {
  lang,
  course,
  title,
  description,
  topics,
  topicSection = 'teoria',
  currentTopic,
  wide = false,
  eyebrow,
} = Astro.props;
const courseTitle = tr(course.title, lang);
const pageTitle = title ? `${title} — ${courseTitle}` : courseTitle;
const base = coursePath(course);

// Panoramica del corso: offre il download per l'offline (service worker).
const isOverview = stripLang(Astro.url.pathname) === base;

let crumbs = Astro.props.crumbs;
if (!crumbs) {
  const rest = stripLang(Astro.url.pathname).slice(base.length).split('/').filter(Boolean);
  crumbs = [
    { label: t(lang, 'nav.home'), href: localizePath('', lang) },
    { label: courseTitle, href: localizePath(base, lang) },
  ];
  const section = COURSE_SECTIONS.find((s) => s.slug && s.slug === rest[0]);
  if (section)
    crumbs.push({ label: t(lang, section.key), href: localizePath(`${base}/${section.slug}`, lang) });
  if (rest.length > 1 && title) crumbs.push({ label: title });
}
// L'occhiello identico al livello superiore del percorso (es. il nome del corso) non si ripete.
const parentLabel = crumbs.findLast((c, i) => i < crumbs.length - 1 && c.href)?.label;
const barEyebrow = eyebrow && eyebrow !== parentLabel ? eyebrow : undefined;
---

<BaseLayout
  lang={lang}
  title={pageTitle}
  description={description ?? tr(course.description, lang)}
  course={course.id}
>
  <slot name="head" slot="head" />
  <div class="container course-shell">
    <aside
      id="indice-corso"
      class="course-shell__side"
      popover="auto"
      data-pagefind-ignore
      aria-label={t(lang, 'nav.course.menu')}
    >
      <div class="course-side__head">
        <span class="eyebrow">{t(lang, 'nav.course.menu')}</span>
        <button
          type="button"
          class="icon-btn icon-btn--bare"
          popovertarget="indice-corso"
          popovertargetaction="hide"
          aria-label={t(lang, 'dialog.close')}
        >
          <Icon name="close" />
        </button>
      </div>
      <CourseNav lang={lang} course={course} />
      {topics && topics.length > 0 && (
        <TopicNav
          lang={lang}
          coursePath={base}
          topics={topics}
          section={topicSection}
          current={currentTopic}
          idPrefix="side"
        />
      )}
      <slot name="aside" />
    </aside>
    <div class="course-shell__main">
      <div
        class="course-bar"
        data-pagefind-ignore
        data-study-page={currentTopic && title ? title : undefined}
        data-study-course={currentTopic ? courseTitle : undefined}
      >
        <button
          type="button"
          class="course-bar__toggle"
          popovertarget="indice-corso"
          aria-label={t(lang, 'nav.course.menu')}
        >
          <Icon name="list" />
          <span class="course-bar__toggle-text">{t(lang, 'nav.course.menuShort')}</span>
        </button>
        <Breadcrumbs lang={lang} items={crumbs} />
        {barEyebrow && <p class="eyebrow course-bar__eyebrow">{barEyebrow}</p>}
      </div>
      <div class:list={[{ reading: !wide }]}>
        <slot />
        {isOverview && (
          <OfflineCourse
            client:visible
            lang={lang}
            courseId={course.id}
            summaryUrl={withBase('offline-summary.json')}
            texts={texts(lang, 'offlineCourse.')}
          />
        )}
        <div class="page-tools" data-pagefind-ignore>
          <ReportError lang={lang} course={course.id} />
          <slot name="tools" />
        </div>
      </div>
    </div>
  </div>
  <CourseTabBar lang={lang} course={course} />
</BaseLayout>
