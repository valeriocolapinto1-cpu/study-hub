---
/** 404 bilingue: GitHub Pages la serve per ogni indirizzo inesistente sotto la base. */
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizePath, t } from '../i18n';
---

<BaseLayout
  lang="it"
  title={t('it', 'notFound.title')}
  description={t('it', 'notFound.body')}
  alternates={false}
  noindex
>
  <div class="container page notfound">
    <p class="notfound__code" aria-hidden="true">
      404
    </p>
    <div class="style-grid style-grid--2">
      <section aria-labelledby="nf-it">
        <h1 id="nf-it" class="page-header__title">
          {t('it', 'notFound.title')}
        </h1>
        <p class="page-header__lede">{t('it', 'notFound.body')}</p>
        <p class="btn-row" style="margin-top: var(--space-m)">
          <a class="btn btn--primary" href={localizePath('', 'it')}>
            {t('it', 'notFound.home')}
          </a>
        </p>
      </section>
      <section lang="en" aria-labelledby="nf-en">
        <h2 id="nf-en" class="page-header__title">
          {t('en', 'notFound.title')}
        </h2>
        <p class="page-header__lede">{t('en', 'notFound.body')}</p>
        <p class="btn-row" style="margin-top: var(--space-m)">
          <a class="btn" href={localizePath('', 'en')} hreflang="en">
            {t('en', 'notFound.home')}
          </a>
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
