---
/** Radice: reindirizza alla lingua preferita (salvata, poi del browser; ripiego italiano). */
import { SITE } from '../config/site';
import { localizePath, t } from '../i18n';
const itHref = localizePath('', 'it');
const enHref = localizePath('', 'en');
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.title.it}</title>
    <meta name="robots" content="noindex, follow" />
    <meta name="description" content={SITE.description.it} />
    <link rel="canonical" href={new URL(itHref, Astro.site).href} />
    <link rel="alternate" hreflang="it-IT" href={new URL(itHref, Astro.site).href} />
    <link rel="alternate" hreflang="en-US" href={new URL(enHref, Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(Astro.url.pathname, Astro.site).href} />
    <script is:inline define:vars={{ itHref, enHref }}>
      var target = itHref;
      try {
        var saved = JSON.parse(localStorage.getItem('sh:v1:global:lang') || 'null');
        if (saved === 'en') target = enHref;
        else if (saved !== 'it') {
          var langs =
            navigator.languages && navigator.languages.length
              ? navigator.languages
              : [navigator.language || ''];
          for (var i = 0; i < langs.length; i++) {
            var l = String(langs[i]).toLowerCase();
            if (l.indexOf('it') === 0) break;
            if (l.indexOf('en') === 0) {
              target = enHref;
              break;
            }
          }
        }
      } catch (e) {}
      location.replace(target + location.search + location.hash);
    </script>
    <noscript>
      <meta http-equiv="refresh" content={`0; url=${itHref}`} />
    </noscript>
    <style>
      body {
        font:
          1rem/1.6 system-ui,
          sans-serif;
        margin: 3rem auto;
        max-width: 36rem;
        padding: 0 1rem;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>{t('it', 'redirect.title')}</h1>
      <p>{t('it', 'redirect.body')}</p>
      <p>
        <a href={itHref} hreflang="it">
          Italiano
        </a>{' '}
        ·{' '}
        <a href={enHref} hreflang="en" lang="en">
          English
        </a>
      </p>
    </main>
  </body>
</html>
