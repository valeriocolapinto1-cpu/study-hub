---
/**
 * Home: per chi torna, la preparazione (ripasso del giorno, progressi per corso,
 * prossimo esame, appunti recenti: isola HomeStudy); per chi arriva, una presentazione
 * sobria con numeri reali calcolati dalle collections, i corsi per anno, cosa offre il
 * sito e chi lo cura. Con zero corsi resta coerente (avviso al posto dell'elenco).
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeStudy from '../../islands/HomeStudy';
import Icon from '../../components/Icon.astro';
import { BASE_URL, SITE } from '../../config/site';
import { langPaths, localizePath, t, texts, tr, type Lang } from '../../i18n';
import { coursePaths } from '../../lib/course-data';
import { coursePath, sortCourses } from '../../lib/courses';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const [courseEntries, topics, exercises, cards, formulas] = await Promise.all([
  getCollection('courses'),
  getCollection('topics'),
  getCollection('exercises'),
  getCollection('cards'),
  getCollection('formulas'),
]);
const courses = sortCourses(courseEntries.map((c) => c.data));
const years = [...new Set(courses.map((c) => c.year))];
const count = <T extends { data: { course: string } }>(list: T[], id: string) =>
  list.filter((x) => x.data.course === id).length;
const perCourse = Object.fromEntries(
  courses.map((c) => [
    c.id,
    {
      topics: count(topics, c.id),
      exercises: count(exercises, c.id),
      cards: count(cards, c.id),
      formulas: count(formulas, c.id),
      extras: c.extras.length,
    },
  ]),
);
const totals = {
  courses: courses.length,
  topics: topics.length,
  exercises: exercises.length,
  cards: cards.length,
  formulas: formulas.length,
  extras: courses.reduce((s, c) => s + c.extras.length, 0),
};
const nf = new Intl.NumberFormat(lang === 'it' ? 'it-IT' : 'en-GB');
const metrics = (
  [
    ['courses', totals.courses],
    ['topics', totals.topics],
    ['exercises', totals.exercises],
    ['cards', totals.cards],
    ['formulas', totals.formulas],
    ['extras', totals.extras],
  ] as const
).filter(([, n]) => n > 0);

const studyCourses = courses.map((c) => {
  const paths = coursePaths(c, lang);
  return {
    id: c.id,
    title: tr(c.title, lang),
    examDates: c.examDates ?? [],
    exerciseIds: exercises.filter((e) => e.data.course === c.id).map((e) => e.data.id),
    cardIds: cards.filter((x) => x.data.course === c.id).map((x) => x.data.id),
    paths: {
      overview: paths.overview,
      review: paths.review,
      progress: paths.progress,
      exercises: paths.exercises,
    },
  };
});
const offers = ['theory', 'exercises', 'review', 'exam', 'offline', 'data'] as const;
const metaLine = (id: string) => {
  const m = perCourse[id]!;
  return [
    m.topics && t(lang, 'home.meta.topics', { n: m.topics }),
    m.exercises && t(lang, 'home.meta.exercises', { n: m.exercises }),
    m.cards && t(lang, 'home.meta.cards', { n: m.cards }),
  ].filter(Boolean);
};
---

<BaseLayout lang={lang} title={SITE.title[lang]} description={SITE.description[lang]}>
  <script is:inline slot="head">
    // Chi ha già dati di studio vede subito "La tua preparazione" (prima del disegno: niente salti).
    try {
      for (var i = 0; i < localStorage.length; i++) {
        var k = localStorage.key(i) || '';
        if (/^sh:v1:[a-z0-9-]+:(progress|srs|notes|exam)$/.test(k) || k === 'sh:v1:global:examDates') {
          document.documentElement.dataset.returning = '';
          break;
        }
      }
    } catch (e) {}
  </script>
  <div class="container page home">
    <header class="home-hero">
      <p class="eyebrow">{t(lang, 'home.eyebrow')}</p>
      <h1>
        <span>{t(lang, 'home.titleLead')}</span>
        <em>{t(lang, 'home.titleEm')}</em>
      </h1>
      <p class="lead">{t(lang, 'home.lead')}</p>
      {courses.length > 0 && (
        <p class="btn-row home-hero__actions">
          <a class="btn btn--primary" href="#corsi">
            {t(lang, 'home.chooseCourse')}
          </a>
          <a class="btn" href={localizePath('ripasso', lang)}>
            {t(lang, 'home.reviewCta')}
          </a>
        </p>
      )}
      {metrics.length > 0 && (
        <dl class="home-metrics glass" aria-label={t(lang, 'home.metricsLabel')}>
          {metrics.map(([k, n]) => (
            <div>
              <dt>{t(lang, `home.metric.${k}`)}</dt>
              <dd>{nf.format(n)}</dd>
            </div>
          ))}
        </dl>
      )}
    </header>

    {courses.length > 0 && (
      <div class="home-study" data-pagefind-ignore>
        <HomeStudy
          client:idle
          lang={lang}
          base={BASE_URL}
          courses={studyCourses}
          reviewPath={localizePath('ripasso', lang)}
          notesPath={localizePath('appunti', lang)}
          texts={texts(lang, 'homeStudy.')}
        />
      </div>
    )}

    <section class="home-section" aria-labelledby="corsi">
      <div class="home-section__head">
        <h2 id="corsi">{t(lang, 'home.courses')}</h2>
        <p class="muted">{t(lang, 'home.coursesSub')}</p>
      </div>
      {courses.length === 0 && <p class="notice">{t(lang, 'home.empty')}</p>}
      {years.map((year) => (
        <section class="home-year" aria-labelledby={`anno-${year}`}>
          <h3 id={`anno-${year}`} class="home-year__title">
            {t(lang, 'home.year', { year })}
          </h3>
          <ul class="home-courses">
            {courses
              .filter((c) => c.year === year)
              .map((c) => (
                <li class="home-course glass" data-course={c.id}>
                  <div class="home-course__head">
                    <p class="home-course__kicker">
                      {c.semester
                        ? t(lang, 'course.yearSemester', { year: c.year, semester: c.semester })
                        : t(lang, 'home.year', { year: c.year })}
                    </p>
                    <span class="home-course__badge">{t(lang, 'home.courseOnline')}</span>
                  </div>
                  <h4 class="home-course__title">
                    <a href={localizePath(coursePath(c), lang)}>{tr(c.title, lang)}</a>
                  </h4>
                  <p class="home-course__desc">{tr(c.description, lang)}</p>
                  {metaLine(c.id).length > 0 && (
                    <dl class="home-course__metrics">
                      {(['topics', 'exercises', 'cards'] as const)
                        .filter((k) => perCourse[c.id]![k] > 0)
                        .map((k) => (
                          <div>
                            <dt>{t(lang, `home.metric.${k}`)}</dt>
                            <dd>{nf.format(perCourse[c.id]![k])}</dd>
                          </div>
                        ))}
                    </dl>
                  )}
                  <p class="home-course__actions" aria-hidden="true">
                    <span class="btn btn--sm btn--primary">{t(lang, 'home.openCourse')}</span>
                  </p>
                </li>
              ))}
          </ul>
        </section>
      ))}
    </section>

    <section class="home-section" aria-labelledby="offerta">
      <div class="home-section__head">
        <h2 id="offerta">{t(lang, 'home.offer.title')}</h2>
      </div>
      <ul class="home-offer">
        {offers.map((k, i) => (
          <li class="glass">
            <span class="home-offer__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{t(lang, `home.offer.${k}.title`)}</h3>
            <p>{t(lang, `home.offer.${k}.text`)}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="home-section home-about glass" aria-labelledby="chi">
      <h2 id="chi">{t(lang, 'home.about.title')}</h2>
      <div class="home-about__body">
        <p>{t(lang, 'home.about.text')}</p>
        <p class="btn-row">
          <a class="btn" href={localizePath('chi-sono', lang)}>
            {t(lang, 'home.about.who')}
          </a>
          <a class="btn" href={localizePath('contribuisci', lang)}>
            {t(lang, 'home.about.contribute')}
          </a>
          <a class="btn btn--ghost" href={SITE.repo.url} rel="noopener">
            <Icon name="star" />
            {t(lang, 'footer.star')}
          </a>
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Home: struttura e aspetto del vecchio study-hub (hero, statistiche in vetro, card dei corsi). */
  .home-hero {
    padding-block: clamp(2.5rem, 9vw, 6.5rem) var(--space-m);
  }
  .home-hero h1 {
    margin: var(--space-s) 0 0;
    max-width: 18ch;
    font: 650 var(--step-5) / 1.04 var(--font-sans);
    letter-spacing: -0.03em;
  }
  .home-hero h1 span,
  .home-hero h1 em {
    display: block;
  }
  .home-hero h1 em {
    font-style: italic;
    font-weight: 400;
    background: var(--brand-gradient-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-right: 0.08em;
  }
  .home-hero .lead {
    margin-top: var(--space-m);
    max-width: 58ch;
  }
  .home-hero__actions {
    margin-top: var(--space-l);
    gap: var(--space-xs);
  }
  .home-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
    margin: clamp(2.5rem, 7vw, 4.5rem) 0 0;
    padding: 0.375rem;
    border-radius: var(--radius-xl);
  }
  .home-metrics div {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-2xs);
    padding: 1.1rem 1.25rem;
  }
  .home-metrics div + div {
    border-left: 1px solid var(--hair);
  }
  .home-metrics dt {
    font: 700 0.7rem / 1.3 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .home-metrics dd {
    margin: 0;
    font: 650 clamp(1.9rem, 4.6vw, 2.9rem) / 1 var(--font-sans);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 40em) {
    .home-metrics {
      grid-template-columns: 1fr 1fr;
    }
    .home-metrics div + div {
      border-left: 0;
    }
  }
  .home-study {
    margin-block: var(--space-xl) 0;
  }
  :global(html:not([data-returning])) .home-study {
    display: none;
  }
  .home-section {
    margin-block: clamp(3.5rem, 9vw, 6.5rem) 0;
  }
  .home-section__head {
    margin-bottom: var(--space-m);
  }
  .home-section__head h2 {
    font: 650 clamp(1.7rem, 4vw, 2.5rem) / 1.15 var(--font-sans);
    letter-spacing: -0.03em;
  }
  .home-section__head .muted {
    margin-top: var(--space-xs);
    max-width: 60ch;
  }
  .home-year + .home-year {
    margin-top: var(--space-l);
  }
  .home-year__title {
    margin: 0 0 var(--space-s);
    font: 700 0.72rem / 1.4 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brand-cyan-text);
  }
  .home-courses {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20.5rem), 1fr));
    gap: 1.125rem;
  }
  .home-course {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 1.5rem;
    border-radius: var(--radius-xl);
    transition:
      transform 0.45s var(--ease),
      border-color 0.3s,
      box-shadow 0.3s;
  }
  .home-course:hover,
  .home-course:focus-within {
    transform: translateY(-5px);
    border-color: var(--hair-strong);
    box-shadow:
      inset 0 1px 0 var(--glass-hi),
      0 24px 60px -20px rgb(110 120 255 / 0.55);
  }
  .home-course:focus-within {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  .home-course__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs);
  }
  .home-course__kicker {
    margin: 0;
    font: 700 0.7rem / 1.2 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .home-course__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.375rem 0.625rem;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in srgb, var(--success) 40%, transparent);
    background: color-mix(in srgb, var(--success) 9%, transparent);
    color: var(--success);
    font: 700 0.68rem / 1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .home-course__badge::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 10px currentColor;
  }
  .home-course__title {
    margin: 0;
    font: 650 1.4rem / 1.2 var(--font-sans);
    letter-spacing: -0.02em;
  }
  .home-course__title a {
    color: var(--text);
    text-decoration: none;
  }
  /* Tutta la card è cliccabile; il focus si vede sul contorno della card. */
  .home-course__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .home-course__title a:focus-visible {
    outline: none;
  }
  .home-course__desc {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .home-course__metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 1.375rem;
    margin: 0;
    padding-top: 0.875rem;
    border-top: 1px solid var(--hair);
  }
  .home-course__metrics div {
    display: flex;
    flex-direction: column-reverse;
  }
  .home-course__metrics dd {
    margin: 0;
    font: 650 1.6rem / 1 var(--font-sans);
    font-variant-numeric: tabular-nums;
  }
  .home-course__metrics dt {
    margin-top: 0.3rem;
    font: 700 0.66rem / 1.2 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .home-course__actions {
    margin: auto 0 0;
    padding-top: 0.375rem;
  }
  .home-offer {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 1rem;
  }
  .home-offer li {
    padding: clamp(1.375rem, 3.4vw, 2rem);
    border-radius: var(--radius-xl);
  }
  .home-offer__n {
    font: 700 0.72rem / 1 var(--font-mono);
    letter-spacing: 0.14em;
    color: var(--brand-cyan-text);
  }
  .home-offer h3 {
    margin: 0.875rem 0 0.5rem;
    font: 650 1.3rem / 1.2 var(--font-sans);
    letter-spacing: -0.02em;
  }
  .home-offer p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.96rem;
  }
  .home-about {
    display: grid;
    gap: clamp(1.25rem, 5vw, 3.5rem);
    padding: clamp(1.625rem, 5vw, 3.25rem);
    border-radius: 30px;
  }
  .home-about h2 {
    font: 650 clamp(1.7rem, 4vw, 2.5rem) / 1.15 var(--font-sans);
    letter-spacing: -0.03em;
  }
  .home-about__body {
    display: grid;
    gap: var(--space-s);
    color: var(--text-muted);
  }
  @media (min-width: 45em) {
    .home-about {
      grid-template-columns: 1fr 1.6fr;
    }
  }
</style>
