---
/**
 * Ringraziamenti. L'elenco parte vuoto: si popola aggiungendo voci a THANKS
 * (solo persone che hanno chiesto di comparire, con il nome da loro indicato).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { langPaths, localizePath, t, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;

interface Thanks {
  name: string;
  /** Cosa ha fatto, in breve (es. "errori in Teoria dei Circuiti"). */
  what?: { it: string; en: string };
}
const THANKS: Thanks[] = [];
---

<BaseLayout lang={lang} title={t(lang, 'thanks.title')} description={t(lang, 'thanks.description')}>
  <div class="container page">
    <PageHeader title={t(lang, 'thanks.title')} lede={t(lang, 'thanks.lead')} />
    <div class="prose">
      {THANKS.length > 0 ? (
        <ul>
          {THANKS.map((p) => (
            <li>
              <strong>{p.name}</strong>
              {p.what && ` — ${p.what[lang]}`}
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted">{t(lang, 'thanks.empty')}</p>
      )}
      <p>{t(lang, 'thanks.how')}</p>
      <p>
        <a class="btn btn--primary" href={localizePath('contribuisci', lang)}>
          {t(lang, 'thanks.cta')}
        </a>
      </p>
    </div>
  </div>
</BaseLayout>
