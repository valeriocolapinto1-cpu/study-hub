---
/**
 * Pagina di prova del kit dei simulatori (non indicizzata): schemi generati
 * dalle netlist, grafici statici (zero JS) e isole interattive (client:visible).
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { langPaths, type Lang } from '../../../i18n';
import Circuit from '../../../sim/Circuit.astro';
import { EXAMPLES } from '../../../sim/circuits/examples';
import { sweep } from '../../../sim/circuits/mna';
import { Plot, BodePlot } from '../../../sim/Plot';
import { PhasorPlane } from '../../../sim/PhasorPlane';
import RcFilterDemo from '../../../sim/demo/RcFilterDemo';
import RlcTransientDemo from '../../../sim/demo/RlcTransientDemo';
import PhasorDemo from '../../../sim/demo/PhasorDemo';
import ScopeDemo from '../../../sim/demo/ScopeDemo';
import FieldDemo from '../../../sim/demo/FieldDemo';
import OscillatorDemo from '../../../sim/demo/OscillatorDemo';
import '../../../sim/sim.css';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;

const T = {
  it: {
    title: 'Kit dei simulatori',
    lead: 'Pagina di prova dei componenti comuni: schemi dei circuiti generati dalle netlist, grafici, fasori, oscilloscopio e campi. Le simulazioni dei corsi sono costruite con questi pezzi.',
    circuits: 'Schemi generati dalle netlist',
    circuitsLead:
      'Ogni figura è prodotta a build-time dalla stessa netlist che usa il risolutore: niente JavaScript nel browser.',
    static: 'Grafici statici',
    staticLead: 'Gli stessi componenti, senza idratazione, producono SVG statici con tabella dei dati.',
    bodeStatic: 'Bode di un RLC serie (passa-banda sulla resistenza)',
    sine: 'Seno e coseno',
    phasors: 'Fasori di tensione e corrente',
    interactive: 'Simulazioni interattive',
    interactiveLead: 'Isole Preact caricate solo quando entrano nello schermo.',
  },
  en: {
    title: 'Simulator kit',
    lead: 'Test page for the shared components: circuit diagrams generated from netlists, plots, phasors, oscilloscope and fields. Course simulations are built from these parts.',
    circuits: 'Diagrams generated from netlists',
    circuitsLead:
      'Each figure is produced at build time from the same netlist used by the solver: no JavaScript in the browser.',
    static: 'Static plots',
    staticLead: 'The same components, without hydration, render static SVG with a data table.',
    bodeStatic: 'Bode plot of a series RLC (band-pass on the resistor)',
    sine: 'Sine and cosine',
    phasors: 'Voltage and current phasors',
    interactive: 'Interactive simulations',
    interactiveLead: 'Preact islands, loaded only when they scroll into view.',
  },
}[lang];

const rlc = {
  elements: [
    { type: 'V', id: 'V1', a: 'a', b: '0', ac: 1 },
    { type: 'L', id: 'L1', a: 'a', b: 'b', value: 0.01 },
    { type: 'C', id: 'C1', a: 'b', b: 'c', value: 1e-6 },
    { type: 'R', id: 'R1', a: 'c', b: '0', value: 20 },
  ],
} as const;
const bode = sweep(rlc, 'V1', { v: 'c' }, { omegaMin: 1e3, omegaMax: 1e5, points: 121 });
const ts = Array.from({ length: 121 }, (_, i) => (i / 120) * 2 * Math.PI);
---

<BaseLayout lang={lang} title={T.title} description={T.lead} noindex alternates>
  <div class="container page prose">
    <h1>{T.title}</h1>
    <p class="lead">{T.lead}</p>

    <h2>{T.circuits}</h2>
    <p>{T.circuitsLead}</p>
    {Object.entries(EXAMPLES).map(([id, net]) => (
      <Circuit netlist={net} lang={lang} caption={net.title} class={`demo-${id}`} />
    ))}

    <h2>{T.static}</h2>
    <p>{T.staticLead}</p>
    <BodePlot
      lang={lang}
      title={T.bodeStatic}
      x={bode.omega}
      axis="omega"
      curves={[{ label: 'H', magDb: bode.magDb, phaseDeg: bode.phaseDeg }]}
    />
    <Plot
      lang={lang}
      title={T.sine}
      cursor={false}
      xLabel="ωt"
      formatX={(v) => `${(v / Math.PI).toFixed(1).replace('.', lang === 'it' ? ',' : '.')}π`}
      series={[
        { label: 'sin ωt', x: ts, y: ts.map(Math.sin), fill: true },
        { label: 'cos ωt', x: ts, y: ts.map(Math.cos), dash: '6 4' },
      ]}
    />
    <PhasorPlane
      lang={lang}
      title={T.phasors}
      unit="V"
      phasors={[
        { label: 'V', re: 10, im: 0 },
        { label: 'I', re: 6, im: -4 },
        { label: 'V_L', re: 0, im: 5, dash: true },
      ]}
    />

    <h2>{T.interactive}</h2>
    <p>{T.interactiveLead}</p>
    <RcFilterDemo client:visible lang={lang} />
    <RlcTransientDemo client:visible lang={lang} />
    <PhasorDemo client:visible lang={lang} />
    <ScopeDemo client:visible lang={lang} />
    <FieldDemo client:visible lang={lang} />
    <OscillatorDemo client:visible lang={lang} />
  </div>
</BaseLayout>
