---
/**
 * Indice del formulario: un capitolo per scheda (argomenti e numero di formule), ricerca per nome
 * in tutte le formule e filtro dei preferiti (sh:v1:<courseId>:formulary), versione stampabile
 * completa. Le formule stanno nelle pagine dei capitoli (formulario/<capitolo>/): qui solo i nomi.
 *
 * Collegamenti vecchi al formulario in una pagina sola (`formulario/#f-<id>`, `#voce-<id>`,
 * `#ft-<argomento>`, `#fg-<n>`): lo script porta al capitolo giusto con la stessa ancora.
 */
import CourseLayout from '../../../../../layouts/CourseLayout.astro';
import PageHeader from '../../../../../components/PageHeader.astro';
import TopicCard from '../../../../../components/TopicCard.astro';
import Icon from '../../../../../components/Icon.astro';
import { texToPlain } from '../../../../../lib/inline-tex';
import {
  courseFormularyChapters,
  coursePaths,
  sectionPath,
  type CourseData,
} from '../../../../../lib/course-pages';
import { localizePath, t, tr, type Lang } from '../../../../../i18n';

export const getStaticPaths = coursePaths;
interface Props {
  course: CourseData;
}
const { course } = Astro.props;
const lang = Astro.params.lang as Lang;
const chapters = await courseFormularyChapters(course.id);
const total = chapters.reduce((n, c) => n + c.count, 0);
const titleOf = (c: (typeof chapters)[number]) =>
  c.group ? tr(c.group, lang) : t(lang, 'nav.course.formulas');
const hrefOf = (c: (typeof chapters)[number]) =>
  localizePath(sectionPath(course, 'formulario', c.slug), lang);
const count = (n: number) => t(lang, n === 1 ? 'formulary.countOne' : 'formulary.count', { n });
const plain = (s: string) => texToPlain(s);
---

<CourseLayout
  lang={lang}
  course={course}
  title={t(lang, 'nav.course.formulas')}
  eyebrow={tr(course.title, lang)}
>
  <PageHeader
    title={t(lang, 'nav.course.formulas')}
    lede={t(lang, 'formulary.indexLede', { n: total, k: chapters.length })}
  />
  <div class="formulary-tools no-print" data-formulary-index={course.id}>
    <div class="field">
      <label class="field__label" for="fq">
        {t(lang, 'formulary.search')}
      </label>
      <input id="fq" class="input" type="search" autocomplete="off" data-fq />
    </div>
    <label class="check">
      <input type="checkbox" data-fstar />
      <span>{t(lang, 'formulary.onlyBookmarks')}</span>
    </label>
    <a class="btn btn--ghost btn--sm" href={localizePath(sectionPath(course, 'formulario', 'stampa'), lang)}>
      <Icon name="printer" />
      {t(lang, 'formulary.printAll')}
    </a>
    <p class="muted formulary-tools__count" aria-live="polite" data-fcount></p>
  </div>
  <ol class="topic-index" data-fchapters>
    {chapters.map((c, i) => (
      <TopicCard
        num={i + 1}
        title={titleOf(c)}
        href={hrefOf(c)}
        summary={c.items.map((x) => tr(x.topic.title, lang)).join(' · ')}
        meta={[count(c.count)]}
      />
    ))}
  </ol>
  {/* Nomi di tutte le formule: nascosti finché non si cerca o si filtrano i preferiti. */}
  <ul class="formulary-hits" data-fhits hidden>
    {chapters.flatMap((c) =>
      c.items.flatMap(({ topic, formulas }) =>
        formulas.map((f) => (
          <li
            data-f={f.id}
            data-t={topic.id}
            data-search={[plain(tr(f.label, lang)), tr(topic.title, lang), f.id].join(' ').toLowerCase()}
            hidden
          >
            <a href={`${hrefOf(c)}#f-${f.id}`}>{plain(tr(f.label, lang))}</a>
            <span class="muted">{titleOf(c)}</span>
          </li>
        )),
      ),
    )}
  </ul>
  <p class="muted" data-fempty hidden>
    {t(lang, 'formulary.empty')}
  </p>
</CourseLayout>

<script>
  import { read } from '../../../../../engine/storage';

  // Ancore del vecchio formulario in una pagina sola → pagina del capitolo, stessa ancora.
  const hits = document.querySelector<HTMLElement>('[data-fhits]');
  const hash = decodeURIComponent(location.hash.slice(1));
  const old = /^(?:f|voce)-(.+)$/.exec(hash);
  const topic = /^ft-(.+)$/.exec(hash);
  const group = /^fg-(\d+)$/.exec(hash);
  const target = old
    ? hits?.querySelector<HTMLAnchorElement>(`[data-f="${CSS.escape(old[1]!)}"] a`)
    : topic
      ? hits?.querySelector<HTMLAnchorElement>(`[data-t="${CSS.escape(topic[1]!)}"] a`)
      : group
        ? document.querySelectorAll<HTMLAnchorElement>('[data-fchapters] .topic-card__title a')[
            Number(group[1])
          ]
        : null;
  if (target) location.replace(old || topic ? `${target.href.split('#')[0]}#${hash}` : target.href);

  const root = document.querySelector<HTMLElement>('[data-formulary-index]');
  if (root && hits) {
    const q = root.querySelector<HTMLInputElement>('[data-fq]')!;
    const star = root.querySelector<HTMLInputElement>('[data-fstar]')!;
    const count = root.querySelector<HTMLElement>('[data-fcount]')!;
    const chapters = document.querySelector<HTMLElement>('[data-fchapters]')!;
    const empty = document.querySelector<HTMLElement>('[data-fempty]')!;
    const items = [...hits.querySelectorAll<HTMLElement>('li')];
    const course = root.dataset.formularyIndex!;
    const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

    const apply = () => {
      const words = norm(q.value).split(/\s+/).filter(Boolean);
      const filtering = words.length > 0 || star.checked;
      const marks = star.checked
        ? new Set(read<{ bookmarks?: string[] }>(course, 'formulary', {}).bookmarks ?? [])
        : null;
      let shown = 0;
      for (const li of items) {
        const hay = norm(li.dataset.search ?? '');
        const ok = filtering && words.every((w) => hay.includes(w)) && (!marks || marks.has(li.dataset.f!));
        li.hidden = !ok;
        if (ok) shown++;
      }
      chapters.hidden = filtering;
      hits.hidden = !filtering;
      count.textContent = filtering ? `${shown} / ${items.length}` : '';
      empty.hidden = !filtering || shown > 0;
    };
    q.addEventListener('input', apply);
    star.addEventListener('change', apply);
    if (q.value || star.checked) apply();
  }
</script>
