---
/**
 * Panoramica del corso: azioni principali e stato locale, indice della pagina, cos'è, struttura d'esame,
 * date suggerite, come usare il sito, mappa degli argomenti (righe compatte, capitoli fissi in alto).
 * Un corso può aggiungere un'introduzione propria in src/courses/<courseId>/Overview.astro (prop `lang`).
 */
import CourseLayout from '../../../../layouts/CourseLayout.astro';
import PageHeader from '../../../../components/PageHeader.astro';
import Icon, { type IconName } from '../../../../components/Icon.astro';
import InlineTex from '../../../../components/InlineTex.astro';
import {
  coursePaths,
  courseTopics,
  groupTopics,
  sectionPath,
  type CourseData,
} from '../../../../lib/course-pages';
import { COURSE_SECTIONS } from '../../../../lib/courses';
import { getCourseIndex } from '../../../../lib/course-data';
import { htmlLang, localizePath, t, tr, withBase, type Lang } from '../../../../i18n';
import { upcomingDates } from '../../../../engine/mastery';
import JsonLd from '../../../../components/JsonLd.astro';
import { SITE } from '../../../../config/site';
import { courseJsonLd, ogImagePath } from '../../../../lib/seo';

export const getStaticPaths = coursePaths;
interface Props {
  course: CourseData;
}
const { course } = Astro.props;
const lang = Astro.params.lang as Lang;
const topics = await courseTopics(course.id);
const groups = groupTopics(topics, lang);
const intros = import.meta.glob<{ default: (props: { lang: Lang }) => unknown }>(
  '../../../../courses/*/Overview.astro',
  { eager: true },
);
const Intro = Object.entries(intros).find(([k]) => k.includes(`/courses/${course.id}/`))?.[1].default;
const fmtDate = (d: string) =>
  new Intl.DateTimeFormat(lang === 'it' ? 'it-IT' : 'en-GB', { dateStyle: 'long', timeZone: 'UTC' }).format(
    new Date(`${d}T12:00:00Z`),
  );
// Appelli già passati alla build: non si mostrano (vedi anche lo script più sotto).
const dates = upcomingDates(course.examDates ?? [], Date.now());
const total = course.exam.structure.reduce((s, x) => s + (x.points ?? 0), 0);
const index = await getCourseIndex(course.id, lang);
const actions: { slug: string; icon: IconName; key: string; meta: string }[] = [
  {
    slug: 'teoria',
    icon: 'book',
    key: 'nav.course.theory',
    meta: t(lang, 'home.meta.topics', { n: topics.length }),
  },
  {
    slug: 'esercizi',
    icon: 'pencil',
    key: 'nav.course.exercises',
    meta: t(lang, 'home.meta.exercises', { n: index.exercises.length }),
  },
  {
    slug: 'ripasso',
    icon: 'cards',
    key: 'nav.course.review',
    meta: t(lang, 'home.meta.cards', { n: index.cards.length }),
  },
  {
    slug: 'esame',
    icon: 'clock',
    key: 'nav.course.exam',
    meta: course.exam.durationMin
      ? t(lang, 'overview.duration', { min: course.exam.durationMin })
      : t(lang, `overview.format.${course.exam.format}`),
  },
];
const toc = [
  ...(Intro ? [{ id: 'il-corso', key: 'overview.toc.course' }] : []),
  { id: 'esame', key: 'overview.exam' },
  { id: 'come-usare', key: 'overview.howto' },
  { id: 'mappa', key: 'overview.toc.map' },
];
const howto = COURSE_SECTIONS.filter((s) => s.slug).map((s) => ({
  href: localizePath(sectionPath(course, s.slug), lang),
  title: t(lang, s.key),
  text: t(lang, `overview.howto.${s.slug}`),
}));
// Dati strutturati del corso (schema.org Course). Qui e non in CourseLayout: lì un import in più
// cambiava l'ordine dei fogli di stile delle pagine del corso (docs/decisions.md).
const site = Astro.site ?? new URL('http://localhost');
const courseLd = courseJsonLd({
  name: tr(course.title, lang),
  description: tr(course.description, lang),
  url: new URL(Astro.url.pathname, site).href,
  inLanguage: htmlLang[lang],
  image: new URL(withBase(ogImagePath(lang, course.id)), site).href,
  provider: { name: SITE.author, url: new URL(localizePath('chi-sono', lang), site).href },
  topics: topics.map((tp) => tr(tp.title, lang)),
  educationalLevel: t(lang, 'seo.educationalLevel'),
});
---

<CourseLayout
  lang={lang}
  course={course}
  topics={topics}
  topicSection="teoria"
  eyebrow={t(lang, 'course.yearSemester', { year: course.year, semester: course.semester ?? 1 })}
>
  <JsonLd slot="head" data={courseLd} />
  <PageHeader title={tr(course.title, lang)} lede={tr(course.description, lang)} />
  <nav class="course-actions" aria-label={t(lang, 'overview.actions')}>
    <ul>
      {actions.map((a) => (
        <li>
          <a href={localizePath(sectionPath(course, a.slug), lang)}>
            <Icon name={a.icon} />
            <span class="course-actions__title">{t(lang, a.key)}</span>
            <span class="course-actions__meta">{a.meta}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <p
    class="course-status"
    data-course-status={course.id}
    data-exercises={index.exercises.map((e) => e.id).join(' ')}
    data-cards={index.cards.map((c) => c.id).join(' ')}
    data-review={localizePath(sectionPath(course, 'ripasso'), lang)}
    data-t-due={t(lang, 'overview.status.due')}
    data-t-resume={t(lang, 'overview.status.resume')}
  >
    <span data-chapter-ids={topics.map((x) => x.id).join(' ')}>
      {t(lang, 'overview.status.theory')}
      <b data-chapter-count data-t="{n} / {total}">
        0 / {topics.length}
      </b>
    </span>
    <span>
      {t(lang, 'overview.status.solved')} <b data-solved>0</b> / {index.exercises.length}
    </span>
    <span>
      {t(lang, 'overview.status.studied')} <b data-cards-studied>0</b> / {index.cards.length}
    </span>
    <a data-studied-next hidden data-t={t(lang, 'overview.status.next')} href="#mappa">
      {t(lang, 'overview.status.next')}
    </a>
  </p>
  <nav class="page-toc" aria-label={t(lang, 'overview.toc')}>
    <ol>
      {toc.map((x) => (
        <li>
          <a href={`#${x.id}`}>{t(lang, x.key)}</a>
        </li>
      ))}
    </ol>
  </nav>
  <div class="prose prose--overview">
    {Intro && (
      <div id="il-corso" class="anchor-target">
        <Intro lang={lang} />
      </div>
    )}

    <h2 id="esame">{t(lang, 'overview.exam')}</h2>
    <p>
      {t(lang, `overview.format.${course.exam.format}`)}
      {course.exam.durationMin && ` · ${t(lang, 'overview.duration', { min: course.exam.durationMin })}`}
    </p>
    {course.exam.structure.length > 0 && (
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">{t(lang, 'overview.part')}</th>
              <th scope="col" class="num">
                {t(lang, 'overview.points')}
              </th>
            </tr>
          </thead>
          <tbody>
            {course.exam.structure.map((s) => (
              <tr>
                <td>
                  <InlineTex text={tr(s.label, lang)} />
                </td>
                <td class="num">{s.points ?? '—'}</td>
              </tr>
            ))}
          </tbody>
          {total > 0 && (
            <tfoot>
              <tr>
                <th scope="row">{t(lang, 'overview.total')}</th>
                <td class="num">{total}</td>
              </tr>
            </tfoot>
          )}
        </table>
      </div>
    )}
    {dates.length > 0 && (
      <>
        <h3 data-exam-dates>{t(lang, 'overview.dates')}</h3>
        <ul class="inline-list" data-exam-dates>
          {dates.map((d) => (
            <li data-date={d}>
              <time datetime={d}>{fmtDate(d)}</time>
            </li>
          ))}
        </ul>
        <p class="muted" data-exam-dates>
          {t(lang, 'overview.datesNote')}
        </p>
        {/* Pagina statica: gli appelli passati dopo la build si tolgono all'apertura. */}
        <script is:inline>
          {
            const n = new Date();
            const today = [n.getFullYear(), n.getMonth() + 1, n.getDate()]
              .map((x) => String(x).padStart(2, '0'))
              .join('-');
            document.querySelectorAll('[data-date]').forEach((li) => li.dataset.date < today && li.remove());
            if (!document.querySelector('[data-date]'))
              document.querySelectorAll('[data-exam-dates]').forEach((el) => el.remove());
          }
        </script>
      </>
    )}

    <h2 id="come-usare">{t(lang, 'overview.howto')}</h2>
    <dl class="howto">
      {howto.map((h) => (
        <div>
          <dt>
            <a href={h.href}>{h.title}</a>
          </dt>
          <dd>{h.text}</dd>
        </div>
      ))}
    </dl>

    <h2 id="mappa">{t(lang, 'overview.map', { n: topics.length })}</h2>
  </div>
  <div class="topic-map" data-studied-next-list data-studied-label={t(lang, 'studied.short')}>
    {groups.map((g, gi) => (
      <section
        class="topic-map__group"
        aria-labelledby={g.title ? `m-${gi + 1}` : undefined}
        data-chapter-ids={g.items.map((x) => x.id).join(' ')}
      >
        {g.title && (
          <h3 class="topic-map__chapter" id={`m-${gi + 1}`}>
            {g.title}{' '}
            <span
              class="topic-map__count"
              data-chapter-count
              data-t={t(lang, 'studied.chapterCount')}
              data-pagefind-ignore
            >
              {t(lang, 'studied.chapterCount', { n: 0, total: g.items.length })}
            </span>
          </h3>
        )}
        <ol class="topic-map__list">
          {g.items.map((x) => (
            <li data-topic={x.id} data-studied-mark={x.id}>
              <p class="topic-map__text">
                <span class="topic-map__num" aria-hidden="true">
                  {String(x.order).padStart(2, '0')}
                </span>
                <a class="topic-map__title" href={localizePath(sectionPath(course, 'teoria', x.id), lang)}>
                  {tr(x.title, lang)}
                </a>{' '}
                <span class="topic-map__summary">
                  <InlineTex text={tr(x.summary, lang)} />
                </span>
              </p>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</CourseLayout>

<script>
  import { buildQueue } from '../../../../engine/fsrs';
  import { exerciseStatus, loadProgress, loadSrs } from '../../../../engine/progress';
  import { read } from '../../../../engine/storage';

  // Stato locale nella panoramica: esercizi risolti, carte studiate e da ripassare, ultima pagina.
  const el = document.querySelector<HTMLElement>('[data-course-status]');
  if (el) {
    const id = el.dataset.courseStatus!;
    const progress = loadProgress(id);
    const srs = loadSrs(id);
    const exercises = new Set((el.dataset.exercises ?? '').split(' '));
    const cards = (el.dataset.cards ?? '').split(' ').filter((c) => c in srs.cards);
    const solved = [...exercises].filter((e) => exerciseStatus(progress.exercises[e]) === 'risolto').length;
    el.querySelector('[data-solved]')!.textContent = String(solved);
    el.querySelector('[data-cards-studied]')!.textContent = String(cards.length);
    const due = cards.length ? buildQueue(cards, srs.cards, Date.now(), { newLimit: 0 }).length : 0;
    if (due > 0) {
      const a = document.createElement('a');
      a.href = el.dataset.review!;
      a.textContent = (el.dataset.tDue ?? '').replace('{n}', String(due));
      el.append(a);
    }
    const last = read<{ href?: string; title?: string } | null>(id, 'lastPage', null);
    if (last?.href && last.title && last.href.startsWith('/')) {
      const a = document.createElement('a');
      a.href = last.href;
      a.textContent = `${el.dataset.tResume} ${last.title}`;
      el.append(a);
    }
  }
</script>
