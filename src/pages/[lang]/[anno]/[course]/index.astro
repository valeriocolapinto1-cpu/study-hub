---
/**
 * Panoramica del corso (R8), pensata per chi arriva la prima volta: titolo e una frase, un solo pulsante
 * principale («Inizia dal primo argomento» / «Riprendi da …»), guida in 3 passi chiudibile, le quattro
 * sezioni, lo stato locale (solo con progressi), i capitoli con l'avanzamento e il link alla pagina info
 * (`info/`: descrizione completa, «Il corso», «L'esame», «Come usare il sito»).
 */
import CourseLayout from '../../../../layouts/CourseLayout.astro';
import PageHeader from '../../../../components/PageHeader.astro';
import Icon, { type IconName } from '../../../../components/Icon.astro';
import {
  coursePaths,
  courseTopics,
  groupTopics,
  sectionPath,
  type CourseData,
} from '../../../../lib/course-pages';
import { getCourseIndex } from '../../../../lib/course-data';
import { htmlLang, localizePath, t, tr, withBase, type Lang } from '../../../../i18n';
import JsonLd from '../../../../components/JsonLd.astro';
import { SITE } from '../../../../config/site';
import { courseJsonLd, ogImagePath } from '../../../../lib/seo';

export const getStaticPaths = coursePaths;
interface Props {
  course: CourseData;
}
const { course } = Astro.props;
const lang = Astro.params.lang as Lang;
const topics = await courseTopics(course.id);
const groups = groupTopics(topics, lang);
const index = await getCourseIndex(course.id, lang);
const actions: { slug: string; icon: IconName; key: string; meta: string }[] = [
  {
    slug: 'teoria',
    icon: 'book',
    key: 'nav.course.theory',
    meta: t(lang, 'home.meta.topics', { n: topics.length }),
  },
  {
    slug: 'esercizi',
    icon: 'pencil',
    key: 'nav.course.exercises',
    meta: t(lang, 'home.meta.exercises', { n: index.exercises.length }),
  },
  {
    slug: 'ripasso',
    icon: 'cards',
    key: 'nav.course.review',
    meta: t(lang, 'home.meta.cards', { n: index.cards.length }),
  },
  {
    slug: 'esame',
    icon: 'clock',
    key: 'nav.course.exam',
    meta: course.exam.durationMin
      ? t(lang, 'overview.duration', { min: course.exam.durationMin })
      : t(lang, `overview.format.${course.exam.format}`),
  },
];
const topicHref = (id: string) => localizePath(sectionPath(course, 'teoria', id), lang);
// Titoli e percorsi degli argomenti per «Riprendi da …» (script della pagina).
const topicMap = Object.fromEntries(topics.map((x) => [x.id, [tr(x.title, lang), topicHref(x.id)]]));
const theoryIndex = localizePath(sectionPath(course, 'teoria'), lang);
const guide = [
  { n: 1, slug: 'teoria' },
  { n: 2, slug: 'esercizi' },
  { n: 3, slug: 'ripasso' },
];
// Dati strutturati del corso (schema.org Course). Qui e non in CourseLayout: lì un import in più
// cambiava l'ordine dei fogli di stile delle pagine del corso (docs/decisions.md).
const site = Astro.site ?? new URL('http://localhost');
const courseLd = courseJsonLd({
  name: tr(course.title, lang),
  description: tr(course.description, lang),
  url: new URL(Astro.url.pathname, site).href,
  inLanguage: htmlLang[lang],
  image: new URL(withBase(ogImagePath(lang, course.id)), site).href,
  provider: { name: SITE.author, url: new URL(localizePath('chi-sono', lang), site).href },
  topics: topics.map((tp) => tr(tp.title, lang)),
  educationalLevel: t(lang, 'seo.educationalLevel'),
});
---

<CourseLayout
  lang={lang}
  course={course}
  topics={topics}
  topicSection="teoria"
  eyebrow={t(lang, 'course.yearSemester', { year: course.year, semester: course.semester ?? 1 })}
>
  <JsonLd slot="head" data={courseLd} />
  <PageHeader title={tr(course.title, lang)} lede={tr(course.tagline, lang)} />
  <p class="course-start">
    <a
      class="btn btn--primary"
      href={topicHref(topics[0]!.id)}
      data-course-start
      data-t={t(lang, 'overview.resumeFrom')}
    >
      {t(lang, 'overview.start')}
    </a>
  </p>
  <section class="first-steps" aria-labelledby="da-dove" data-first-steps>
    <h2 id="da-dove" class="first-steps__title">
      {t(lang, 'overview.guide')}
    </h2>
    <ol class="first-steps__list">
      {guide.map((g) => (
        <li>
          <a href={localizePath(sectionPath(course, g.slug), lang)}>{t(lang, `overview.guide.${g.n}`)}</a>{' '}
          <span>{t(lang, `overview.guide.${g.n}.text`)}</span>
        </li>
      ))}
    </ol>
    <button type="button" class="btn btn--sm btn--ghost first-steps__close" data-first-steps-close>
      {t(lang, 'overview.guide.close')}
    </button>
  </section>
  <nav class="course-actions" aria-label={t(lang, 'overview.actions')}>
    <ul>
      {actions.map((a) => (
        <li>
          <a href={localizePath(sectionPath(course, a.slug), lang)}>
            <Icon name={a.icon} />
            <span class="course-actions__title">{t(lang, a.key)}</span>
            <span class="course-actions__meta">{a.meta}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <p
    class="course-status"
    hidden
    data-course-status={course.id}
    data-exercises={index.exercises.map((e) => e.id).join(' ')}
    data-cards={index.cards.map((c) => c.id).join(' ')}
    data-topics={JSON.stringify(topicMap)}
    data-review={localizePath(sectionPath(course, 'ripasso'), lang)}
    data-t-due={t(lang, 'overview.status.due')}
    data-t-resume={t(lang, 'overview.status.resume')}
  >
    <span data-chapter-ids={topics.map((x) => x.id).join(' ')}>
      {t(lang, 'overview.status.theory')}
      <b data-chapter-count data-t="{n} / {total}">
        0 / {topics.length}
      </b>
    </span>
    <span>
      {t(lang, 'overview.status.solved')} <b data-solved>0</b> / {index.exercises.length}
    </span>
    <span>
      {t(lang, 'overview.status.studied')} <b data-cards-studied>0</b> / {index.cards.length}
    </span>
  </p>
  {/* Prima del disegno: guida già chiusa su questo dispositivo, stato visibile se ci sono dati del corso. */}
  <script is:inline define:vars={{ course: course.id }}>
    try {
      if (localStorage.getItem('sh:v1:global:firstSteps'))
        document.querySelector('[data-first-steps]')?.setAttribute('hidden', '');
      if (['progress', 'srs', 'studied'].some((a) => localStorage.getItem(`sh:v1:${course}:${a}`)))
        document.querySelector('[data-course-status]')?.removeAttribute('hidden');
    } catch {
      // storage non disponibile: guida visibile, stato deciso dallo script della pagina
    }
  </script>
  <p class="course-info-link">
    <a href={localizePath(sectionPath(course, 'info'), lang)}>{t(lang, 'overview.info')}</a>
  </p>
  <section class="chapters" aria-labelledby="argomenti">
    <h2 id="argomenti" class="chapters__title">
      {t(lang, 'overview.map', { n: topics.length })}
    </h2>
    <ol class="chapters__list">
      {groups.map((g, gi) => (
        <li data-chapter-ids={g.items.map((x) => x.id).join(' ')}>
          <a href={g.title ? `${theoryIndex}#g-${gi + 1}` : theoryIndex}>
            <span class="chapters__name">{g.title ?? t(lang, 'nav.course.theory')}</span>
            <span class="chapters__count" data-chapter-count data-t={t(lang, 'studied.chapterCount')}>
              {t(lang, 'studied.chapterCount', { n: 0, total: g.items.length })}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</CourseLayout>

<script>
  import { buildQueue } from '../../../../engine/fsrs';
  import { exerciseStatus, loadProgress, loadSrs } from '../../../../engine/progress';
  import { read } from '../../../../engine/storage';
  import { firstUnstudied, loadStudied } from '../../../../engine/studied';

  const KEY = 'sh:v1:global:firstSteps';
  const guide = document.querySelector<HTMLElement>('[data-first-steps]');
  guide?.querySelector('[data-first-steps-close]')?.addEventListener('click', () => {
    try {
      localStorage.setItem(KEY, '1');
    } catch {
      // storage non disponibile: la guida si chiude solo per questa visita
    }
    guide.hidden = true;
    document.querySelector<HTMLElement>('[data-course-start]')?.focus();
  });

  // Stato locale: pulsante principale, esercizi risolti, carte studiate e da ripassare, ultima pagina.
  const el = document.querySelector<HTMLElement>('[data-course-status]');
  const start = document.querySelector<HTMLAnchorElement>('[data-course-start]');
  if (el && start) {
    const id = el.dataset.courseStatus!;
    const progress = loadProgress(id);
    const srs = loadSrs(id);
    const studied = loadStudied(id);
    const topics = JSON.parse(el.dataset.topics ?? '{}') as Record<string, [string, string]>;
    const exercises = new Set((el.dataset.exercises ?? '').split(' '));
    const cards = (el.dataset.cards ?? '').split(' ').filter((c) => c in srs.cards);
    const solved = [...exercises].filter((e) => exerciseStatus(progress.exercises[e]) === 'risolto').length;
    const nStudied = Object.keys(topics).filter((t) => studied.topics[t]).length;
    el.querySelector('[data-solved]')!.textContent = String(solved);
    el.querySelector('[data-cards-studied]')!.textContent = String(cards.length);
    el.hidden = !(solved || cards.length || nStudied);
    const due = cards.length ? buildQueue(cards, srs.cards, Date.now(), { newLimit: 0 }).length : 0;
    if (due > 0) {
      const a = document.createElement('a');
      a.href = el.dataset.review!;
      a.textContent = (el.dataset.tDue ?? '').replace('{n}', String(due));
      el.append(a);
    }
    // «Riprendi da …»: primo argomento non studiato; senza argomenti studiati (o con tutti studiati)
    // l'ultima pagina aperta; con tutti studiati e nessuna pagina, il primo argomento.
    const ids = Object.keys(topics);
    const last = read<{ href?: string; title?: string } | null>(id, 'lastPage', null);
    const lastOk = !!(last?.href && last.title && last.href.startsWith('/'));
    const next = nStudied ? topics[firstUnstudied(ids, studied) ?? ''] : undefined;
    const target = next ?? (lastOk ? [last!.title!, last!.href!] : nStudied ? topics[ids[0]!] : undefined);
    if (target) {
      start.textContent = `${start.dataset.t} ${target[0]}`;
      start.href = target[1];
    }
    if (lastOk && target?.[1] !== last!.href) {
      const a = document.createElement('a');
      a.href = last!.href!;
      a.textContent = `${el.dataset.tResume} ${last!.title}`;
      el.append(a);
      el.hidden = false;
    }
  }
</script>
