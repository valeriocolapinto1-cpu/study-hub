---
/** Indice della teoria: argomenti nell'ordine e nei gruppi del sito originale. */
import CourseLayout from '../../../../../layouts/CourseLayout.astro';
import PageHeader from '../../../../../components/PageHeader.astro';
import TopicCard from '../../../../../components/TopicCard.astro';
import {
  coursePaths,
  courseTopics,
  groupTopics,
  sectionPath,
  type CourseData,
} from '../../../../../lib/course-pages';
import { localizePath, t, tr, type Lang } from '../../../../../i18n';

export const getStaticPaths = coursePaths;
interface Props {
  course: CourseData;
}
const { course } = Astro.props;
const lang = Astro.params.lang as Lang;
const topics = await courseTopics(course.id);
const groups = groupTopics(topics, lang);
---

<CourseLayout
  lang={lang}
  course={course}
  title={t(lang, 'nav.course.theory')}
  topics={topics}
  topicSection="teoria"
  eyebrow={tr(course.title, lang)}
>
  <PageHeader title={t(lang, 'nav.course.theory')} lede={t(lang, 'theory.indexLede', { n: topics.length })} />
  {groups.map((g, gi) => (
    <section
      class="topic-index__group"
      aria-labelledby={g.title ? `g-${gi + 1}` : undefined}
      data-chapter-ids={g.items.map((x) => x.id).join(' ')}
      data-studied-label={t(lang, 'studied.short')}
    >
      {g.title && (
        <div class="chapter-head">
          <h2 class="topic-index__group-title" id={`g-${gi + 1}`}>
            {g.title}
          </h2>
          <p class="chapter-head__tools" data-pagefind-ignore>
            <span class="chapter-head__count" data-chapter-count data-t={t(lang, 'studied.chapterCount')}>
              {t(lang, 'studied.chapterCount', { n: 0, total: g.items.length })}
            </span>
            <button
              type="button"
              class="btn btn--sm btn--ghost"
              data-studied-chapter
              hidden
              data-label-off={t(lang, 'studied.chapterMark')}
              data-label-on={t(lang, 'studied.chapterUndo')}
              aria-describedby={`g-${gi + 1}`}
            >
              {t(lang, 'studied.chapterMark')}
            </button>
          </p>
        </div>
      )}
      <ol class="topic-index">
        {g.items.map((x) => (
          <TopicCard
            num={x.order}
            title={tr(x.title, lang)}
            href={localizePath(sectionPath(course, 'teoria', x.id), lang)}
            summary={tr(x.summary, lang)}
            meta={[t(lang, 'theory.objectivesCount', { n: x.objectives.length })]}
            topicId={x.id}
            studiedMark
          />
        ))}
      </ol>
    </section>
  ))}
</CourseLayout>
