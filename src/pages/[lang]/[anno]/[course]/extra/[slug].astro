---
/**
 * Approfondimenti di un corso (course.extras). Il contenuto è un componente del corso:
 * src/courses/<courseId>/extras/<slug>.astro (prop `lang`).
 */
import CourseLayout from '../../../../../layouts/CourseLayout.astro';
import PageHeader from '../../../../../components/PageHeader.astro';
import { coursePaths, type CourseData } from '../../../../../lib/course-pages';
import { tr, type Lang } from '../../../../../i18n';

type ExtraModule = { default: (props: { lang: Lang; course: CourseData }) => unknown; wide?: boolean };
const load = () => import.meta.glob<ExtraModule>('../../../../../courses/*/extras/*.astro', { eager: true });
const find = (modules: Record<string, ExtraModule>, course: string, slug: string) =>
  Object.entries(modules).find(([k]) => k.endsWith(`/courses/${course}/extras/${slug}.astro`))?.[1];

export async function getStaticPaths() {
  const modules = import.meta.glob<ExtraModule>('../../../../../courses/*/extras/*.astro', { eager: true });
  const has = (course: string, slug: string) =>
    Object.keys(modules).some((k) => k.endsWith(`/courses/${course}/extras/${slug}.astro`));
  return (await coursePaths()).flatMap((p) =>
    p.props.course.extras
      .filter((x) => has(p.props.course.id, x.slug))
      .map((x) => ({ params: { ...p.params, slug: x.slug }, props: { ...p.props, extra: x } })),
  );
}
interface Props {
  course: CourseData;
  extra: CourseData['extras'][number];
}
const { course, extra } = Astro.props;
const lang = Astro.params.lang as Lang;
const mod = find(load(), course.id, extra.slug)!;
const Body = mod.default;
---

<CourseLayout lang={lang} course={course} title={tr(extra.title, lang)} wide={mod.wide ?? false}>
  <PageHeader eyebrow={tr(course.title, lang)} title={tr(extra.title, lang)} />
  <Body lang={lang} course={course} />
</CourseLayout>
