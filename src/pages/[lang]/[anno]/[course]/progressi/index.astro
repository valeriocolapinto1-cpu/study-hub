---
/**
 * Pagina generica della sezione per ogni corso. Un corso può sostituirla
 * creando una pagina statica allo stesso percorso (le rotte statiche hanno la precedenza).
 */
import CourseLayout from '../../../../../layouts/CourseLayout.astro';
import CourseProgress from '../../../../../components/course/CourseProgress.astro';
import { getCourse, courseStaticPaths, courseTopicsNav } from '../../../../../lib/course-data';
import { t, type Lang } from '../../../../../i18n';

export const getStaticPaths = courseStaticPaths;
const lang = Astro.params.lang as Lang;
const { courseId } = Astro.props as { courseId: string };
const course = await getCourse(courseId);
const topics = await courseTopicsNav(courseId);
---

<CourseLayout
  lang={lang}
  course={course}
  topics={topics}
  topicSection="esercizi"
  wide
  title={t(lang, 'page.progress.title')}
  description={t(lang, 'page.progress.lead')}
>
  <CourseProgress lang={lang} courseId={courseId} />
</CourseLayout>
