---
/** Tutti gli appunti personali (salvati nel browser). */
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AllNotes from '../../../islands/AllNotes';
import SectionHeader from '../../../components/course/SectionHeader.astro';
import { langPaths, t, tr, type Lang } from '../../../i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const courseTitles = Object.fromEntries(
  (await getCollection('courses')).map((c) => [c.data.id, tr(c.data.title, lang)]),
);
---

<BaseLayout lang={lang} title={t(lang, 'page.notes.title')} description={t(lang, 'notes.allLead')}>
  <div class="container page">
    <SectionHeader title={t(lang, 'notes.all')} lead={t(lang, 'notes.allLead')} />
    <AllNotes client:load lang={lang} courseTitles={courseTitles} />
  </div>
</BaseLayout>
