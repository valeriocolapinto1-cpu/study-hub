---
/**
 * Contribuisci: suggerimenti, segnalazioni di errori, appunti e materiali.
 * Il modulo (isola ContributeForm) invia al Google Apps Script configurato in
 * SITE.contribute (tools/apps-script, docs/CONTRIBUTI.md); se l'endpoint non è
 * configurato prepara un'email precompilata. Precompilazione da
 * `?corso=…&pagina=…&tipo=errore|miglioria|appunti` (link "Segnala un errore").
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContributeForm from '../../islands/ContributeForm';
import { SITE } from '../../config/site';
import { langPaths, localizePath, t, texts, tr, type Lang } from '../../i18n';
import { sortCourses } from '../../lib/courses';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const courses = sortCourses((await getCollection('courses')).map((c) => c.data)).map((c) => ({
  id: c.id,
  title: tr(c.title, lang),
  year: c.year,
}));
---

<BaseLayout lang={lang} title={t(lang, 'contribute.title')} description={t(lang, 'contribute.description')}>
  <div class="container page">
    <PageHeader title={t(lang, 'contribute.title')} lede={t(lang, 'contribute.lead')} />
    <div class="contribute-layout">
      <div class="contribute-layout__form">
        <ContributeForm
          client:idle
          lang={lang}
          endpoint={SITE.contribute.endpoint}
          siteKey={SITE.contribute.turnstileSiteKey}
          email={SITE.contacts.email}
          issuesUrl={`${SITE.repo.issues}/new`}
          privacyHref={localizePath('privacy', lang)}
          courses={courses}
          texts={texts(lang, 'cf.')}
        />
      </div>
      <aside class="contribute-layout__aside stack" aria-labelledby="contribute-how">
        <h2 id="contribute-how" class="eyebrow">
          {t(lang, 'contribute.how')}
        </h2>
        <ul class="contribute-tips">
          <li>{t(lang, 'contribute.tip1')}</li>
          <li>{t(lang, 'contribute.tip2')}</li>
          <li>{t(lang, 'contribute.tip3')}</li>
        </ul>
        <h2 class="eyebrow">{t(lang, 'contribute.notesTitle')}</h2>
        <p>{t(lang, 'contribute.notesBody')}</p>
        <h2 class="eyebrow">{t(lang, 'contribute.otherTitle')}</h2>
        <ul class="contribute-links">
          <li>
            <a href={`mailto:${SITE.contacts.email}`}>
              <Icon name="mail" />
              {SITE.contacts.email}
            </a>
          </li>
          <li>
            <a href={`${SITE.repo.issues}/new`} rel="noopener">
              <Icon name="code" />
              {t(lang, 'contribute.byIssue')}
            </a>
          </li>
        </ul>
        <p class="muted contribute-privacy">
          {t(lang, 'contribute.privacy')}{' '}
          <a href={localizePath('privacy', lang)}>{t(lang, 'privacy.title')}</a> ·
          <a href={localizePath('ringraziamenti', lang)}>{t(lang, 'thanks.title')}</a>
        </p>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .contribute-layout {
    display: grid;
    gap: var(--space-2xl);
    align-items: start;
  }
  @media (min-width: 64em) {
    .contribute-layout {
      grid-template-columns: minmax(0, 42rem) minmax(14rem, 20rem);
      justify-content: space-between;
    }
    .contribute-layout__aside {
      position: sticky;
      top: calc(var(--space-3xl) + var(--space-s));
    }
  }
  .contribute-layout__aside {
    --flow: var(--space-s);
    font: 400 var(--step--1) / 1.55 var(--font-sans);
    padding-top: var(--space-s);
    border-top: 1px solid var(--border);
  }
  .contribute-layout__aside h2 {
    margin: var(--space-m) 0 0;
  }
  .contribute-layout__aside h2:first-child {
    margin-top: 0;
  }
  .contribute-tips,
  .contribute-links {
    margin: 0;
    padding-inline-start: 1.1em;
  }
  .contribute-links {
    list-style: none;
    padding: 0;
  }
  .contribute-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 2rem;
    overflow-wrap: anywhere;
  }
  .contribute-privacy {
    font-size: var(--step--2);
  }
</style>
