---
/**
 * Contribuisci (R14): un link al Google Form configurato in `SITE.contribuisci.formUrl`
 * (risposte in un Foglio di Drive, poi lette e verificate in una sessione: docs/CONTRIBUTI.md).
 * Con l'URL vuoto la pagina dice che il modulo è in arrivo e non mostra il pulsante; email e
 * segnalazione GitHub restano sempre. Nessuno script e nessuna richiesta verso Google: il link
 * apre il modulo in una nuova scheda. I link «Segnala un errore» arrivano qui con
 * `?corso=…&pagina=…&tipo=errore` (parametri pronti per un'eventuale precompilazione del modulo).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PageHeader from '../../components/PageHeader.astro';
import { SITE, contribuisciFormUrl } from '../../config/site';
import { langPaths, localizePath, t, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const formUrl = contribuisciFormUrl();
---

<BaseLayout lang={lang} title={t(lang, 'contribute.title')} description={t(lang, 'contribute.description')}>
  <div class="container page">
    <PageHeader title={t(lang, 'contribute.title')} lede={t(lang, 'contribute.lead')} />
    <div class="contribute-layout">
      <div class="contribute-layout__main prose">
        {formUrl ? (
          <section aria-labelledby="contribute-form" data-contribute-form>
            <h2 id="contribute-form">{t(lang, 'contribute.formTitle')}</h2>
            <p>{t(lang, 'contribute.formBody')}</p>
            <p>
              <a class="btn btn--primary" href={formUrl} target="_blank" rel="noopener noreferrer">
                {t(lang, 'contribute.formOpen')}
                <span class="visually-hidden"> {t(lang, 'contribute.newTab')}</span>
              </a>
            </p>
            <p class="muted contribute-note">
              {t(lang, 'contribute.formPrivacy')}{' '}
              <a href={localizePath('privacy', lang)}>{t(lang, 'privacy.title')}</a>
            </p>
          </section>
        ) : (
          <section aria-labelledby="contribute-soon" class="contribute-soon" data-contribute-soon>
            <h2 id="contribute-soon">{t(lang, 'contribute.soonTitle')}</h2>
            <p>{t(lang, 'contribute.soonBody')}</p>
          </section>
        )}
        <h2 id="contribute-how">{t(lang, 'contribute.how')}</h2>
        <ul>
          <li>{t(lang, 'contribute.tip1')}</li>
          <li>{t(lang, 'contribute.tip2')}</li>
          <li>{t(lang, 'contribute.tip3')}</li>
        </ul>
        <h2>{t(lang, 'contribute.notesTitle')}</h2>
        <p>{t(lang, 'contribute.notesBody')}</p>
      </div>
      <aside class="contribute-layout__aside stack" aria-labelledby="contribute-other">
        <h2 id="contribute-other" class="eyebrow">
          {t(lang, 'contribute.otherTitle')}
        </h2>
        <ul class="contribute-links">
          <li>
            <a href={`mailto:${SITE.contacts.email}`}>
              <Icon name="mail" />
              {SITE.contacts.email}
            </a>
          </li>
          <li>
            <a href={`${SITE.repo.issues}/new`} rel="noopener">
              <Icon name="code" />
              {t(lang, 'contribute.byIssue')}
            </a>
          </li>
        </ul>
        <p class="muted contribute-privacy">
          {t(lang, 'contribute.privacy')}{' '}
          <a href={localizePath('privacy', lang)}>{t(lang, 'privacy.title')}</a> ·
          <a href={localizePath('ringraziamenti', lang)}>{t(lang, 'thanks.title')}</a>
        </p>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .contribute-layout {
    display: grid;
    gap: var(--space-2xl);
    align-items: start;
  }
  @media (min-width: 64em) {
    .contribute-layout {
      grid-template-columns: minmax(0, 42rem) minmax(14rem, 20rem);
      justify-content: space-between;
    }
    .contribute-layout__aside {
      position: sticky;
      top: calc(var(--space-3xl) + var(--space-s) + var(--safe-top));
    }
  }
  .contribute-layout__aside {
    --flow: var(--space-s);
    font: 400 var(--step--1) / 1.55 var(--font-sans);
    padding-top: var(--space-s);
    border-top: 1px solid var(--border);
  }
  .contribute-layout__aside h2 {
    margin: var(--space-m) 0 0;
  }
  .contribute-layout__aside h2:first-child {
    margin-top: 0;
  }
  .contribute-links {
    list-style: none;
    padding: 0;
  }
  .contribute-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 2rem;
    overflow-wrap: anywhere;
  }
  .contribute-privacy {
    font-size: var(--step--2);
  }
  .contribute-layout__main > section:first-child h2 {
    margin-top: 0;
  }
  .contribute-note {
    font-size: var(--step--1);
  }
  .contribute-soon {
    padding: var(--space-s) var(--space-m);
    border: 1px solid var(--border);
    border-inline-start: 3px solid var(--warning);
    border-radius: var(--radius-m);
    background: var(--surface);
  }
  .contribute-soon h2 {
    margin-top: 0;
  }
</style>
