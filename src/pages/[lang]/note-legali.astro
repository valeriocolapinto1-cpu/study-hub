---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { langPaths, t, type Lang } from '../../i18n';
import { formatDate, legalText } from '../../lib/texts';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const { Content } = await legalText('note-legali', lang);
---

<BaseLayout lang={lang} title={t(lang, 'legal.title')} description={t(lang, 'legal.description')}>
  <div class="container page">
    <PageHeader
      title={t(lang, 'legal.title')}
      lede={t(lang, 'updated', { date: formatDate('2026-11-05', lang) })}
    />
    <div class="prose">
      <Content />
    </div>
  </div>
</BaseLayout>
