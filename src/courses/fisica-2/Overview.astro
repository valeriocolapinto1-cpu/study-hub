---
/**
 * Introduzione della Panoramica di Fisica Generale II: il corso, come funziona l'esame (dal sito originale,
 * data/corso.json ed esame.json), testo e materiali, e il programma lezione per lezione con le spunte.
 */
import Checklist from './islands/Checklist';
import { BLOCCHI, LEZIONI, TIPI, type Blocco } from './data';
import { localizePath, type Lang } from '../../i18n';
import { sectionPath } from '../../lib/course-pages';
import { TOPIC_IDS } from '../../../tools/legacy-topics/fisica-2.mjs';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const it = lang === 'it';
const course = { id: 'fisica-2', year: 2 };
const p = (...rest: string[]) => localizePath(sectionPath(course, ...rest), lang);
// blocco di ciascun argomento (id di sezione del programma originale → capitolo)
const bloccoDi = Object.fromEntries(Object.entries(TOPIC_IDS).map(([sez, id]) => [id, sez.slice(0, 2) as Blocco]));
const gruppi = (Object.keys(BLOCCHI) as Blocco[])
  .map((b, i) => ({
    id: b,
    title: `${i + 1}. ${BLOCCHI[b][lang]}`,
    items: LEZIONI.filter((l) => (l.topics[0] ? bloccoDi[l.topics[0]] === b : b === 'b7')).map((l) => ({
      id: String(l.n),
      label: `${l.n}. ${l.title[lang]}`,
      meta: TIPI[l.tipo][lang],
      href: l.topics[0] ? p('teoria', l.topics[0]) : undefined,
    })),
  }))
  .filter((g) => g.items.length);
---

<p>
  {it
    ? 'Il corso di Fisica Generale II del corso di laurea in Ingegneria Elettronica (2° anno, 1° semestre, 12 CFU, settore FIS/01) copre l\'elettromagnetismo classico e l\'ottica ondulatoria: 120 ore, di cui 72 in aula e 48 di esercitazioni e laboratorio. Prerequisiti: Analisi Matematica 1 (propedeutica), consigliata Fisica 1; servono meccanica di base, derivate, integrali e algebra vettoriale.'
    : 'General Physics II, in the Electronic Engineering degree programme (2nd year, 1st semester, 12 ECTS, sector FIS/01), covers classical electromagnetism and wave optics: 120 hours, 72 in the classroom and 48 of exercise classes and laboratory. Prerequisites: Mathematical Analysis 1 (required), Physics 1 recommended; basic mechanics, derivatives, integrals and vector algebra are needed.'}
</p>

<h2 id="come-si-svolge">{it ? 'Come si svolge l\'esame' : 'How the exam works'}</h2>
<ul>
  <li>
    {it
      ? 'Scritto (2 ore e 30 minuti, nessun materiale ammesso): 4 esercizi da 6 punti e 2 domande di teoria da 3 punti; si supera con almeno 18/30.'
      : 'Written test (2 hours 30 minutes, no material allowed): 4 exercises worth 6 points and 2 theory questions worth 3 points; passed with at least 18/30.'}
  </li>
  <li>
    {it
      ? 'Orale: 3 domande di teoria da 10 punti; possono esserci domande sulle esperienze di laboratorio e si portano le relazioni svolte durante il corso.'
      : 'Oral exam: 3 theory questions worth 10 points; there may be questions on the laboratory experiments and you bring the reports written during the course.'}
  </li>
  <li>{it ? 'Voto finale: media tra il punteggio dello scritto e quello dell\'orale.' : 'Final mark: average of the written and oral scores.'}</li>
</ul>
<p>
  {it ? 'Allo scritto si valutano: equazioni di Maxwell (ricavarle e applicarle), problemi di elettrostatica, magnetostatica e circuiti, induzione elettromagnetica, fenomeni ondulatori (potenza trasportata, riflessione, rifrazione, interferenza). Vedi anche gli ' : 'The written test assesses: Maxwell\'s equations (deriving and applying them), problems in electrostatics, magnetostatics and circuits, electromagnetic induction, wave phenomena (transported power, reflection, refraction, interference). See also the '}
  <a href={p('extra', 'appelli')}>{it ? 'appelli passati' : 'past exam sessions'}</a>
  {it ? ' e il ' : ' and the '}
  <a href={p('extra', 'laboratorio')}>{it ? 'laboratorio' : 'laboratory'}</a>.
</p>

<h2 id="testo">{it ? 'Testo e materiali' : 'Textbook and materials'}</h2>
<ul>
  <li>
    C. Mencuccini, V. Silvestrini, <em>Fisica II – Elettromagnetismo, Ottica</em>, Zanichelli
    {it ? ' (capitoli 1-3, 4, 5-6, 7, 9-10 per i blocchi 1-5).' : ' (chapters 1-3, 4, 5-6, 7, 9-10 for blocks 1-5).'}
  </li>
  <li>{it ? 'Dispense dei docenti sulla teoria della misura (lezioni 22-23).' : 'Lecturers\' notes on measurement theory (lessons 22-23).'}</li>
  <li>{it ? 'Testi degli appelli precedenti: cartella ufficiale del corso, indicata dai docenti.' : 'Past exam papers: official course folder, given by the lecturers.'}</li>
</ul>

<h2 id="lezioni">{it ? 'Il programma lezione per lezione' : 'The programme lesson by lesson'}</h2>
<p>
  {it
    ? 'Le 60 lezioni del corso nell\'ordine in cui sono state svolte, raggruppate per capitolo del programma. Spunta quelle che hai studiato: restano in questo browser (anche quelle segnate sul vecchio sito).'
    : 'The 60 lessons of the course in the order they were given, grouped by programme chapter. Tick the ones you have studied: they stay in this browser (including those ticked on the old site).'}
</p>
<details class="f2-lezioni">
  <summary>{it ? 'Mostra le 60 lezioni' : 'Show the 60 lessons'}</summary>
  <Checklist
    client:visible
    scope="fisica-2"
    area="lessons"
    label={it ? 'Lezioni studiate' : 'Lessons studied'}
    progressLabel={it ? '{done} di {total}' : '{done} of {total}'}
    groups={gruppi}
  />
</details>
